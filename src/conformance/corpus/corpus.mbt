///|
/// Every case of the corpus, in the order the files were read.
pub fn cases() -> Array[(String, String, String)] {
  let all = []
  all.append(chunk_0())
  all.append(chunk_1())
  all.append(chunk_2())
  all.append(chunk_3())
  all.append(chunk_4())
  all.append(chunk_5())
  all.append(chunk_6())
  all
}
