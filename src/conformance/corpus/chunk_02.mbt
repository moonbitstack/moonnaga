      "bitcast", "@compute @workgroup_size(1)\nfn main() {\n    var i2 = vec2<i32>(0);\n    var i3 = vec3<i32>(0);\n    var i4 = vec4<i32>(0);\n\n    var u2 = vec2<u32>(0u);\n    var u3 = vec3<u32>(0u);\n    var u4 = vec4<u32>(0u);\n\n    var f2 = vec2<f32>(0.0);\n    var f3 = vec3<f32>(0.0);\n    var f4 = vec4<f32>(0.0);\n\n    u2 = bitcast<vec2<u32>>(i2);\n    u3 = bitcast<vec3<u32>>(i3);\n    u4 = bitcast<vec4<u32>>(i4);\n\n    i2 = bitcast<vec2<i32>>(u2);\n    i3 = bitcast<vec3<i32>>(u3);\n    i4 = bitcast<vec4<i32>>(u4);\n\n    f2 = bitcast<vec2<f32>>(i2);\n    f3 = bitcast<vec3<f32>>(i3);\n    f4 = bitcast<vec4<f32>>(i4);\n}\n",
